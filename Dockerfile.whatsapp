FROM node:18-slim

# Install comprehensive dependencies for Puppeteer / Chromium
RUN apt-get update \
    && apt-get install -y wget gnupg chromium \
    && rm -rf /var/lib/apt/lists/*

ENV PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true
ENV PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium

WORKDIR /app

COPY package*.json ./
RUN npm install

COPY whatsapp_service.js .
# Do not copy auth folder directly in dockerfile, it's better to mount it as a volume if needed, 
# or just let it generate a new one.

EXPOSE 3000

CMD ["node", "whatsapp_service.js"]
